class Solution {
    public int mySqrt(int x) {
        if (x < 2) {
            return x;
        }

        int left = 1;
        int right = x / 2;
        int ans = 0;

        while (left <= right) {
            int mid = left + (right - left) / 2;

            // Using mid <= x / mid instead of mid * mid <= x to prevent integer overflow
            if (mid <= x / mid) {
                ans = mid;      // mid is a valid candidate; try finding a larger one
                left = mid + 1;
            } else {
                right = mid - 1;
            }
        }

        return ans;
    }
}
